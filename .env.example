# ══════════════════════════════════════════════════════════
# NILA IoT Backend — Environment Variables
# cp .env.example .env  →  isi sesuai konfigurasi
# ══════════════════════════════════════════════════════════

# ── DATABASE ──────────────────────────────────────────────
# Otomatis diisi Railway dari service PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/nilaiot_db

# ── AUTH ──────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti_dengan_random_string_minimal_32_karakter

# ── APP ───────────────────────────────────────────────────
DEBUG=False
CORS_ORIGINS=*

# ── ML MODELS ─────────────────────────────────────────────
AI_MODEL_PATH=ml/models/rf_classifier.pkl
AI_SCALER_PATH=ml/models/scaler.pkl
AI_ENCODER_PATH=ml/models/label_encoder.pkl

# ── MQTT BROKER ───────────────────────────────────────────
MQTT_BROKER_HOST=broker.hivemq.com
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=nilaiot-backend
MQTT_TOPIC_SENSOR=aqua/sensor/data
MQTT_TOPIC_ACTUATOR_COMMAND=aqua/actuator/command
MQTT_TOPIC_ACTUATOR_STATUS=aqua/actuator/status
MQTT_TOPIC_ALERT=aqua/alert

# ── SIMULATOR (untuk service simulator di Railway) ────────
SIM_MODE=siklus
SIM_INTERVAL=5
SIM_DEVICE=sensor-01
SIM_LOG_LEVEL=normal
